# SALIN file ini menjadi .env — JANGAN commit .env ke git.
# JANGAN pernah menempel private key di chat, issue, atau file publik.
# Gunakan wallet deployment khusus (bukan wallet utama) dan simpan
# key-nya di secret manager / hardware wallet bila memungkinkan.

# RPC BNB Smart Chain Mainnet (boleh pakai endpoint publik Binance)
BSC_RPC_URL=https://bsc-dataseed.binance.org/
# RPC testnet (untuk uji deployment sebelum mainnet)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
# API key BscScan untuk verifikasi kontrak (opsional tapi disarankan)
BSCSCAN_API_KEY=
# Private key deployer — HANYA di .env lokal, tanpa prefix 0x ganda bila Hardhat meminta.
# Format: 0x... (64 hex char). Kosongkan bila tidak deploy dari CLI ini.
DEPLOYER_PRIVATE_KEY=
# Base URI metadata, contoh setelah upload IPFS:
# ipfs://<CID>/  (akhiri dengan / karena tokenURI menambahkan "<id>.json")
# Biarkan kosong bila metadata belum siap; setBaseURI bisa dipanggil nanti.
BASE_URI=
# Alamat kontrak hasil deployment (untuk authorize-agent.js)
CONTRACT_ADDRESS=
# Alamat agent yang akan diotorisasi (untuk authorize-agent.js)
AGENT_ADDRESS=
